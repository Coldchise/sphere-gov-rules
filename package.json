{
  "name": "@coldchise/gov-rules",
  "version": "0.1.0",
  "description": "Philippine statutory contribution and withholding tax calculator: SSS, PhilHealth, Pag-IBIG, and BIR TRAIN-law monthly withholding tax.",
  "license": "MIT",
  "author": "Christian Vergara",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "philippines",
    "payroll",
    "sss",
    "philhealth",
    "pag-ibig",
    "hdmf",
    "bir",
    "withholding-tax",
    "train-law",
    "statutory-contributions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coldchise/sphere-gov-rules.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project backend-unit",
    "test:coverage": "vitest run --coverage --project backend-unit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
